{
  "name": "eduportal-api-starter",
  "version": "1.0.0",
  "description": "Backend modular paso a paso para EduPortal con MongoDB y Express - Módulo Asignaturas (Subjects)",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:init": "tsx src/seed/init-db.ts",
    "db:reset": "tsx src/seed/init-db.ts --reset",
    "seed": "tsx src/seed/subjects.seed.ts",
    "seed:areas": "tsx src/seed/areas.seed.ts",
    "test": "tsx --test tests/**/*.test.ts",
    "test:unit": "tsx --test tests/backend-acceptance-criteria.test.ts",
    "test:e2e": "tsx --test tests/e2e-http.test.ts"
  },
  "keywords": [
    "express",
    "mongodb",
    "mongoose",
    "typescript",
    "eduportal",
    "subjects"
  ],
  "author": "Félix Chacaliaza",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mongoose": "^8.9.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
